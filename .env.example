# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=

# Preferred modern public key. Churning also supports the legacy ANON key below
# so existing Vercel projects do not break during migration.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional legacy fallback (leave blank if using the publishable key above).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Research Agent (SERVER-ONLY — never prefix these with NEXT_PUBLIC_)
# Preferred modern Supabase server secret. Legacy SUPABASE_SERVICE_ROLE_KEY is also supported.
SUPABASE_SECRET_KEY=

# Comma-separated account emails that are allowed to open /research and trigger manual scans.
RESEARCH_ADMIN_EMAILS=

# Long random value used by Vercel Cron to authenticate weekly full scans, daily expiring-offer checks,
# and the daily discovery eligibility check.
CRON_SECRET=

# Biweekly discovery engine. Churning currently uses Brave Search and accepts either variable name.
# Keep this server-only. The daily cron only runs a full discovery sweep when 14 days have elapsed.
DISCOVERY_SEARCH_API_KEY=
# Optional compatibility alias:
BRAVE_SEARCH_API_KEY=

# Optional email delivery for My Plan reminders. Without these, reminders stay in-app only.
RESEND_API_KEY=
REMINDER_FROM_EMAIL=
